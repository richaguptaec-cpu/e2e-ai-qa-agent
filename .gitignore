@'
# Python
__pycache__/
*.py[cod]
*.pyd
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/

# Secrets and environment variables
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Test and coverage reports
.pytest_cache/
.coverage
htmlcov/
coverage.xml
test-results/
playwright-report/
allure-results/
allure-report/

# Streamlit
.streamlit/secrets.toml

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Logs and temporary files
*.log
tmp/
temp/

# Generated reports and local artifacts (uncomment if you don't want to track them)
# reports/
# output/
'@ | Set-Content -Encoding utf8 .gitignore